# ====================================================
# 通用 AI 客服评估测试平台 - 环境变量配置文件 (.env.example)
# ====================================================

# 服务运行端口 (默认 3000)
PORT=3000

# ====================================================
# MySQL 数据库配置 (选配参数)
# ====================================================
# 如果配置了以下 MySQL 参数，服务端启动时将自动连接数据库并自动初始化建表；
# 如果留空或未配置，系统将自动使用 [轻量本地文件 data/db.json 持久化存储]；
# 若纯静态托管 public/ 目录，数据则保存在浏览器的 localStorage 中。

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ai_customer_service_eval
DB_PASSWORD=your_mysql_password
DB_NAME=ai_customer_service_eval
