# 服务端口配置
PORT=3000

# 存储模式 (可选: auto / mysql / file / memory)
# auto: 自动判断，有 MySQL 配置则用 mysql，无则用本地 file (data/db.json)
# mysql: 强制使用关系型数据库
# file (或 json): 强制使用本地 JSON 文件持久化存储
STORAGE_MODE=auto

# MySQL 数据库配置 (STORAGE_MODE=mysql 或 auto 时有效)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ai_customer_service_eval

# 服务端 AI 模型 API Base URL (中转站/代理地址)
# 填写后可防止中转站 API 地址在前端曝光泄漏
BASE_URL=

# 服务端 API Key 预设 (前端留空时自动使用服务端 Key)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

